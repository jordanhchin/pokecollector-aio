#!/bin/bash
set -Eeuo pipefail

umask 027
: "${POSTGRES_USER:=pokemon}" "${POSTGRES_DB:=pokemon_tcg}" "${WEB_PORT:=3000}"
[[ "$POSTGRES_USER" =~ ^[a-zA-Z_][a-zA-Z0-9_-]*$ ]] || { echo >&2 "Invalid POSTGRES_USER"; exit 64; }
[[ "$POSTGRES_DB" =~ ^[a-zA-Z_][a-zA-Z0-9_-]*$ ]] || { echo >&2 "Invalid POSTGRES_DB"; exit 64; }
if [[ ! "$WEB_PORT" =~ ^[0-9]+$ ]] || (( WEB_PORT < 1 || WEB_PORT > 65535 )); then
  echo >&2 "WEB_PORT must be an integer from 1 to 65535"; exit 64
fi
export PGDATA=/config/postgresql/data
export DATABASE_URL="${DATABASE_URL:-postgresql://${POSTGRES_USER}:$(python3 -c 'import os,urllib.parse; print(urllib.parse.quote(os.environ.get("POSTGRES_PASSWORD",""),safe=""))')@127.0.0.1:5432/${POSTGRES_DB}}"

# A bind mount created by mktemp (and some Unraid share configurations) can be
# mode 0700. PostgreSQL is unprivileged and needs to traverse the mount root.
chown root:postgres /config
chmod 0750 /config
install -d -m 0750 /config/{app,uploads,backups,auth,scan-traces,logs} "$PGDATA"
chown -R postgres:postgres /config/postgresql /run/postgresql
if [[ -s "$PGDATA/PG_VERSION" ]] && [[ "$(cat "$PGDATA/PG_VERSION")" != "18" ]]; then
  echo >&2 "Unsupported PostgreSQL data version $(cat "$PGDATA/PG_VERSION"); migrate it to 18 before starting."; exit 1
fi
if [[ ! -s "$PGDATA/PG_VERSION" ]]; then
  [[ -n "${POSTGRES_PASSWORD:-}" ]] || { echo >&2 'POSTGRES_PASSWORD is required on first run.'; exit 64; }
  pwfile=$(mktemp); trap 'rm -f "$pwfile"' EXIT
  printf '%s' "$POSTGRES_PASSWORD" > "$pwfile"; chown postgres:postgres "$pwfile"
  runuser -u postgres -- initdb -D "$PGDATA" --username="$POSTGRES_USER" --pwfile="$pwfile" --auth-host=scram-sha-256 --auth-local=trust
  printf "listen_addresses = '127.0.0.1'\npassword_encryption = 'scram-sha-256'\n" >> "$PGDATA/postgresql.auto.conf"
  touch /config/postgresql/.first-run
fi

export AIO_CREATE_DATABASE="$POSTGRES_DB"
sed -i "s/listen 3000;/listen ${WEB_PORT};/" /etc/nginx/conf.d/default.conf
exec /usr/bin/supervisord -c /etc/supervisor/supervisord.conf
