#!/bin/bash
set -Eeuo pipefail
until pg_isready -q -h 127.0.0.1 -U "$POSTGRES_USER"; do sleep 1; done
if [[ -e /config/postgresql/.first-run ]]; then
  if [[ "$POSTGRES_DB" != postgres ]]; then
    exists=$(runuser -u postgres -- psql -Atqc "SELECT 1 FROM pg_database WHERE datname = '$POSTGRES_DB'" postgres)
    [[ "$exists" == 1 ]] || runuser -u postgres -- createdb -O "$POSTGRES_USER" "$POSTGRES_DB"
  fi
  rm -f /config/postgresql/.first-run
fi
cd /opt/pokecollector/backend
exec uvicorn main:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips=127.0.0.1
