<?xml version="1.0"?>
<Container version="2">
  <Name>PokéCollector AIO</Name>
  <Repository>ghcr.io/jordanhchin/pokecollector-aio:latest</Repository>
  <Registry>https://github.com/jordanhchin/pokecollector-aio/pkgs/container/pokecollector-aio</Registry>
  <Network>bridge</Network>
  <Shell>bash</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/jordanhchin/pokecollector-aio/issues</Support>
  <Project>https://github.com/Git-Romer/pokecollector</Project>
  <Overview>Unofficial all-in-one packaging of PokéCollector with PostgreSQL, FastAPI, React, and nginx. Only the web interface is published.</Overview>
  <Category>Productivity: Tools:</Category>
  <WebUI>http://[IP]:[PORT:3000]/</WebUI>
  <TailscaleStateDir>/config/.tailscale_state</TailscaleStateDir>
  <Config Name="Persistent configuration" Target="/config" Default="/mnt/user/appdata/pokecollector-aio" Mode="rw" Description="All database, uploads, backups, and authentication state." Type="Path" Display="always" Required="true" Mask="false"/>
  <Config Name="Web UI" Target="3000" Default="3000" Mode="tcp" Description="PokéCollector web interface." Type="Port" Display="always" Required="true" Mask="false"/>
  <Config Name="Database password" Target="POSTGRES_PASSWORD" Default="" Description="Required strong password; never change after first initialization." Type="Variable" Display="always" Required="true" Mask="true"/>
  <Config Name="Admin username" Target="ADMIN_USERNAME" Default="admin" Description="Initial application administrator username." Type="Variable" Display="always" Required="false" Mask="false"/>
  <Config Name="Admin password" Target="ADMIN_PASSWORD" Default="" Description="Initial application administrator password." Type="Variable" Display="always" Required="false" Mask="true"/>
  <Config Name="User mode" Target="USER_MODE" Default="" Description="Blank for app setting, single for recovery, or multi for login." Type="Variable" Display="advanced" Required="false" Mask="false"/>
  <Config Name="JWT secret" Target="JWT_SECRET_KEY" Default="" Description="Leave blank to securely generate and persist under /config/auth." Type="Variable" Display="advanced" Required="false" Mask="true"/>
  <Config Name="Catalogue languages" Target="TCGDEX_SYNC_LANGUAGES" Default="en,de" Description="Comma-separated TCGdex languages." Type="Variable" Display="advanced" Required="false" Mask="false"/>
  <Config Name="Gemini API key" Target="GEMINI_API_KEY" Default="" Description="Optional scanner API key." Type="Variable" Display="advanced" Required="false" Mask="true"/>
  <Config Name="Telegram bot token" Target="TELEGRAM_BOT_TOKEN" Default="" Description="Optional notification bot token." Type="Variable" Display="advanced" Required="false" Mask="true"/>
  <Config Name="Telegram chat ID" Target="TELEGRAM_CHAT_ID" Default="" Description="Optional notification chat ID." Type="Variable" Display="advanced" Required="false" Mask="false"/>
</Container>
